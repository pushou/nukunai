---
# Native BASH/SH reverse shell: direct /dev/tcp/ or /dev/udp/ opening by a shell
# interpreter -- the most reliable reverse shell source (no legitimate usage).
# Separate from the "-i nc/socat" case: here the -i option is not needed, using /dev/tcp
# in a shell command line is already an active compromise indicator.
name: reverse_shell.execve.detection
type: detection
meta:
  tags: ["reverse_shell", "type_detection", "event_execve", "event_execve_script", "T1059.004"]
  attack: [ T1059.004 ]
  authors: ["nukunai"]
  comments:
    - detect bash/sh/zsh/ksh/dash opening /dev/tcp or /dev/udp (no legitimate use case)
match-on:
  events:
    kunai: [execve, execve_script]
matches:
  $shell: '.data.command_line ~= "\b(bash|sh|zsh|ksh|dash)\b"'
  $dev:   '.data.command_line ~= "\b(/dev/tcp/|/dev/udp/)"'
condition: $shell and $dev
severity: 10
