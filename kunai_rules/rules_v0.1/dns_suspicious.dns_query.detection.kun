---
name: dns_suspicious.dns_query.detection
type: detection
meta:
  tags: ["dns_suspicious", "type_detection", "event_dns_query", "T1568.002", "T1071.004"]
  attack: [ T1568.002 ]
  authors: ["nukunai"]
match-on:
  events:
    kunai: [dns_query]
# Suspicious TLDs (T1568.002) OR abnormally long query (>60, DNS tunneling,
# T1071.004). The length is expressed with a regex (gene has no len()).
# Single-quoted YAML values to preserve the backslashes.
matches:
  $tld:  '.data.query ~= "(?:\.tk$|\.ml$|\.ga$|\.cf$|\.gq$|\.top$|\.xyz$|\.pw$|\.onion$|\.i2p$)"'
  $long: '.data.query ~= ".{61,}"'
condition: $tld or $long
severity: 7
