---
name: mmap_exec_tmp.mmap_exec.detection
type: detection
meta:
  tags: ["mmap_exec_tmp", "type_detection", "event_mmap_exec", "T1055.001", "T1071"]
  attack: [ T1055.001 ]
  authors: ["nukunai"]
match-on:
  events:
    kunai: [mmap_exec]
# Exécution (mmap exec) depuis une zone temporaire / fd / memfd (T1055.001).
# Le chemin exposé par kunai est .data.mapped.file (pas .path).
matches:
  $m: '.data.mapped.file ~= "(?:/tmp/|/var/tmp/|/dev/shm/|/run/shm/|/proc/self/fd/|memfd:)"'
condition: $m
severity: 8
