---
name: obfuscated_exec.execve.detection
type: detection
meta:
  tags: ["obfuscated_exec", "type_detection", "event_execve", "T1027", "T1140"]
  attack: [ T1027 ]
  authors: ["nukunai"]
match-on:
  events:
    kunai: [execve, execve_script]
matches:
  $ob: '.data.command_line ~= "(?:base64 -d|base64 -D|xxd -r|openssl enc|perl -e|python3? -c|php -r)"'
condition: $ob
severity: 8
