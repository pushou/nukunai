---
name: set_dumpable.prctl.detection
type: detection
meta:
  tags: ["set_dumpable", "type_detection", "event_prctl", "T1622"]
  attack: [ T1622 ]
  authors: ["nukunai"]
match-on:
  events:
    kunai: [prctl]
# PR_SET_DUMPABLE modification (evasion / memory capture bypass, T1622).
# note: .data.option is a string, not an integer.
matches:
  $d: '.data.option == "PR_SET_DUMPABLE"'
condition: $d
severity: 7
